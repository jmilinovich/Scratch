# ---------------------------------------------------------------------------
# WHOOP HR — configuration
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- Path #1 / #2: Official developer API (OAuth2 authorization-code) --------
# Create an app at https://developer-dashboard.whoop.com to get these.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the app.
WHOOP_REDIRECT_URI=http://localhost:8080/callback
# Where the OAuth token (access + refresh) is persisted locally.
WHOOP_TOKEN_FILE=.whoop_token.json

# --- Path #3: Internal web-app API (FALLBACK ONLY) --------------------------
# Your real WHOOP account login. Reverse-engineered, fragile, against WHOOP ToS.
# Leave WHOOP_ALLOW_INTERNAL=false unless the official stream (Phase 2) fails.
WHOOP_USERNAME=
WHOOP_PASSWORD=
WHOOP_ALLOW_INTERNAL=false

# Optional overrides (defaults are correct for prod as of this writing)
# WHOOP_API_BASE=https://api.prod.whoop.com
